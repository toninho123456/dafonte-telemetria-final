APP_URL="http://localhost:3000"
# gere com: npx auth secret
AUTH_SECRET=""
# Google Cloud Console > Credenciais > ID do cliente OAuth. URI de redirecionamento: APP_URL/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# usados só pelo seed (concessionária Dafonte de Bayeux-PB)
