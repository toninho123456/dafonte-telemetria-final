# Porta do servidor (dev e produção). APP_URL deve ser o endereço que você abre no navegador (o WebSocket confere a origem).
PORT="3000"
# E-mail (recuperar senha). Sem SMTP_HOST, em desenvolvimento o texto aparece no console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
